{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "release": true
    }
  },
  "ignoreCommand": "bash ./scripts/vercel-ignore.sh",
  "buildCommand": "yarn export:web",
  "installCommand": "yarn install --frozen-lockfile",
  "outputDirectory": "dist",
  "devCommand": "yarn web",
  "cleanUrls": true,
  "framework": null,
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/"
    }
  ]
}
