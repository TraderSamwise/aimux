#!/usr/bin/env bash
if [ -z "${BASH_VERSION:-}" ]; then
  printf '%s must be run with bash\n' "$0" >&2
  exit 2
fi
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SOURCE_ROOT="$ROOT_DIR"
MANIFEST_PATH="$ROOT_DIR/native/Cargo.toml"
NEEDS_METADATA=1

# Every expansion of this array below uses `${ARGS[@]+...}`: with no arguments
# it is EMPTY, and bash 3.2 -- which is the `bash` on every macOS -- treats
# `"${ARGS[@]}"` on an empty array as unbound under `set -u`. It printed
# `ARGS[@]: unbound variable`, exited 0, and the caller read that as a pass, so
# this gate had not run on a developer Mac at all; CI, on bash 5, ran it. A
# spawn site added on 2026-10-15 reached a PR because of it.
ARGS=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --source-root)
      SOURCE_ROOT="$(cd "$2" && pwd)"
      ARGS+=("$1" "$SOURCE_ROOT")
      shift 2
      ;;
    --manifest-path)
      MANIFEST_PATH="$2"
      ARGS+=("$1" "$2")
      shift 2
      ;;
    --skip-package-identity-check)
      printf '%s\n' "scripts/check-local-network-surface refuses --skip-package-identity-check; use fixture-specific checker inputs instead of disabling the real gate." >&2
      exit 2
      ;;
    --package-identities-file)
      NEEDS_METADATA=0
      ARGS+=("$1")
      ARGS+=("$2")
      shift 2
      ;;
    *)
      ARGS+=("$1")
      shift
      ;;
  esac
done

if [ "$NEEDS_METADATA" -eq 0 ]; then
  exec "$ROOT_DIR/scripts/run-yarn" node "$ROOT_DIR/scripts/check-local-network-surface.mjs" ${ARGS[@]+"${ARGS[@]}"}
fi

TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/aimux-local-network-surface.XXXXXX")"
cleanup() {
  rm -rf "$TMP_DIR"
}
trap cleanup EXIT

METADATA="$TMP_DIR/cargo-metadata.json"
cargo metadata --manifest-path "$MANIFEST_PATH" --no-default-features --format-version=1 >"$METADATA"
exec "$ROOT_DIR/scripts/run-yarn" node "$ROOT_DIR/scripts/check-local-network-surface.mjs" ${ARGS[@]+"${ARGS[@]}"} --cargo-metadata-file "$METADATA"
