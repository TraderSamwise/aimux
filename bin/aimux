#!/usr/bin/env sh
set -eu

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

detect_platform() {
  case "$(uname -s)" in
    Darwin) printf 'darwin' ;;
    Linux) printf 'linux' ;;
    *)
      printf 'aimux: unsupported platform: %s\n' "$(uname -s)" >&2
      exit 1
      ;;
  esac
}

detect_arch() {
  case "$(uname -m)" in
    x86_64 | amd64) printf 'x64' ;;
    arm64 | aarch64) printf 'arm64' ;;
    *)
      printf 'aimux: unsupported architecture: %s\n' "$(uname -m)" >&2
      exit 1
      ;;
  esac
}

if [ -n "${AIMUX_NATIVE_BIN:-}" ]; then
  if [ -x "$AIMUX_NATIVE_BIN" ]; then
    exec "$AIMUX_NATIVE_BIN" "$@"
  fi
  printf 'aimux: native binary is not executable: %s\n' "$AIMUX_NATIVE_BIN" >&2
  exit 127
fi

PLATFORM="$(detect_platform)"
ARCH="$(detect_arch)"

for candidate in \
  "$ROOT_DIR/native/$PLATFORM-$ARCH/aimux" \
  "$ROOT_DIR/native/target/release/aimux" \
  "$ROOT_DIR/native/target/debug/aimux"
do
  if [ -x "$candidate" ]; then
    export AIMUX_ROOT="${AIMUX_ROOT:-$ROOT_DIR}"
    export AIMUX_NATIVE_BIN="$candidate"
    exec "$candidate" "$@"
  fi
done

printf 'aimux: native binary not found; run `cargo build --manifest-path native/Cargo.toml -p aimux` or install a release asset\n' >&2
exit 127
